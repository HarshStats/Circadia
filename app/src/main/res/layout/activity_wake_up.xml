<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWakeUp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_dark_blue">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/top_glow_gradient" />

    <TextView
        android:id="@+id/tvWakeUpTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/neon_blue"
        android:textSize="80sp"
        android:fontFamily="sans-serif-thin"
        app:layout_constraintBottom_toTopOf="@id/tvWakeUpLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvWakeUpLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WAKE UP"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.5"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutSwipeGuide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWakeUpTime" />

    <LinearLayout
        android:id="@+id/layoutSwipeGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲"
            android:textColor="@color/neon_blue"
            android:textSize="24sp"
            android:alpha="0.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SWIPE UP TO DISMISS"
            android:textColor="@color/neon_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginVertical="8dp"/>

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/glass_card_bg"
            android:alpha="0.3"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SWIPE DOWN TO SNOOZE"
            android:textColor="@color/neon_purple"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="@color/neon_purple"
            android:textSize="24sp"
            android:alpha="0.5" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>