<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_dark_blue"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvMusicHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="SLEEP SOUNDS"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vAlbumArt"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/glass_card_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMusicHeader" />

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_moon_neon"
        app:tint="@color/neon_blue"
        app:layout_constraintTop_toTopOf="@id/vAlbumArt"
        app:layout_constraintBottom_toBottomOf="@id/vAlbumArt"
        app:layout_constraintStart_toStartOf="@id/vAlbumArt"
        app:layout_constraintEnd_toEndOf="@id/vAlbumArt"/>

    <TextView
        android:id="@+id/tvTrackTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fireplace &amp; Rain"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/vAlbumArt" />

    <TextView
        android:id="@+id/tvTrackStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paused"
        android:textColor="@color/neon_purple"
        android:textSize="14sp"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTrackTitle" />

    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏮"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:layout_marginEnd="40dp" />

        <TextView
            android:id="@+id/btnPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="▶"
            android:textColor="@color/brand_dark_blue"
            android:textSize="24sp"
            android:gravity="center"
            android:background="@drawable/circle_neon_bg"/>

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏭"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:layout_marginStart="40dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>